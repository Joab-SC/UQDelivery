# Normaliza los saltos de línea: en el repo siempre LF,
# cada quien los ve como su sistema los necesite.
* text=auto

# Scripts de Unix deben quedar con LF (si no, fallan en Linux/Docker/Render)
backend/gradlew text eol=lf
*.sh text eol=lf

# Scripts de Windows con CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binarios
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.pptx binary
*.docx binary
*.xlsx binary
