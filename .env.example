# Copiar este archivo como .env (en la raíz del repo) y ajustar si hace falta.
# Lo leen docker-compose y el backend. El .env no se sube a git.

# Base de datos
POSTGRES_PORT=5432
POSTGRES_DB=uqdelivery
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# JWT (clave de mínimo 32 caracteres; duración en minutos)
JWT_SECRET=clave-local-de-desarrollo-uqdelivery-no-usar-en-produccion
JWT_EXP=120

# Front
CORS_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200

# Correo (Brevo SMTP, puerto 2525). MAIL_PASSWORD es la clave SMTP, no la API key.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=2525
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@uqdelivery.co

# Contraseña de los usuarios iniciales
SEED_PASSWORD=Clave123*
