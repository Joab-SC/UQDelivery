        <mxCell id="lg" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;" value="Línea sólida con flecha abierta = asociación navegable (atributo)&amp;nbsp;&lt;div&gt;línea punteada = dependencia («create», «use»)&amp;nbsp;&lt;/div&gt;&lt;div&gt;flecha con triángulo hueco = generalización&lt;/div&gt;&lt;div&gt;nota punteada = patrón GRASP.&amp;nbsp;&lt;/div&gt;&lt;div&gt;Las dependencias hacia los DTO (EnvioRequest, EnvioResponse, CiudadResponse, PoliticasResponse) se leen en las firmas de los métodos y se omiten para no saturar el diagrama.&lt;/div&gt;" vertex="1">
          <mxGeometry height="125" width="1900" x="20" y="1976" as="geometry" />
        </mxCell>
        <mxCell id="oHLuBpXLLoBnjt140zGZ-1" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;b&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;HU-04 - Solicitud de envío - Dig.Clases de diseño &lt;/font&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;font style=&quot;&quot;&gt;parcia&lt;/font&gt;l&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="36" width="748" x="20" y="-109" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
