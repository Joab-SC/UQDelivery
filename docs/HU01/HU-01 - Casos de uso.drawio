<mxfile host="app.diagrams.net" agent="claude" version="24.7.0"><diagram id="HU-01_-_Casos_de_uso" name="HU-01 - Casos de uso"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Sistema UQDelivery · HU-01" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="240" y="30" width="540" height="340" as="geometry"/></mxCell><mxCell id="c3" value="Visitante&lt;br&gt;(sin sesión)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="80" width="30" height="60" as="geometry"/></mxCell><mxCell id="c4" value="Usuario registrado&lt;br&gt;(ADMIN, EMISOR, REPARTIDOR)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="250" width="30" height="60" as="geometry"/></mxCell><mxCell id="c5" value="Registrarse&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;HU-01&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E6E6E6;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="290" y="80" width="170" height="80" as="geometry"/></mxCell><mxCell id="c6" value="Validar datos de registro" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="560" y="80" width="190" height="80" as="geometry"/></mxCell><mxCell id="c7" value="Iniciar sesión&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;HU-01&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E6E6E6;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="290" y="250" width="170" height="80" as="geometry"/></mxCell><mxCell id="c8" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="«include»" style="dashed=1;endArrow=open;endFill=0;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;Registrarse:&lt;/b&gt; crea siempre una cuenta con rol EMISOR y responde 201 sin token (después hay que iniciar sesión).&lt;br&gt;&lt;b&gt;Validar datos de registro:&lt;/b&gt; campos obligatorios, contraseña segura (mín. 8, mayúscula, minúscula y número), contraseña y confirmación iguales, correo único.&lt;br&gt;&lt;b&gt;Flujos alternos:&lt;/b&gt; campos inválidos o contraseñas distintas (400) · correo ya registrado (409).&lt;br&gt;&lt;b&gt;Iniciar sesión:&lt;/b&gt; devuelve un token JWT de 2 horas y los datos del usuario.&lt;br&gt;&lt;b&gt;Flujo alterno:&lt;/b&gt; credenciales incorrectas (401, mensaje genérico: no revela si falló el correo o la contraseña)." style="shape=note;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;spacingRight=6;fillColor=#fff2cc;strokeColor=#d6b656;backgroundOutline=1;size=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="395" width="540" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>